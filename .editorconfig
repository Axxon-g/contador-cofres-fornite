root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.cs]
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion

[*.{csproj,slnx}]
indent_size = 2

[*.{md,json}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[*.ps1]
charset = utf-8-bom
