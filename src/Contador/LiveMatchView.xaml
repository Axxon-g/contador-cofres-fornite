<UserControl x:Class="Contador.LiveMatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="LiveVisible"/>
        <Style x:Key="LiveActionFocus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-4" Stroke="{StaticResource Ink}" StrokeThickness="2"
                                   RadiusX="10" RadiusY="10"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LiveAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="Foreground" Value="{StaticResource Ground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource LiveActionFocus}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualCaptureEnabled}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Ground}"/>
                    <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,24,0">
                <TextBlock Text="Conteo en tiempo real" FontSize="24" FontWeight="SemiBold"/>
                <Border Background="{StaticResource Ground}" CornerRadius="6" Padding="10,5"
                        HorizontalAlignment="Left" Margin="0,10,0,0">
                    <TextBlock x:Name="CountState" Text="{Binding VisualStateLabel}" FontSize="12" FontWeight="SemiBold"
                               AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisualCounting}" Value="True">
                                        <Setter Property="Foreground" Value="#A9D5A5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
            <StackPanel x:Name="LiveMetric" Grid.Column="1" Width="144" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Visibility="{Binding VisualCaptureEnabled, Converter={StaticResource LiveVisible}}">
                <TextBlock x:Name="LiveNumber" Text="{Binding VisualCount}" FontSize="44" FontWeight="SemiBold"
                           HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VisualCaptureEnabled}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="cofres · estimación" FontSize="12" Foreground="{StaticResource Muted}"
                           TextAlignment="Right" Width="144"/>
            </StackPanel>
        </Grid>
        <TextBlock Text="{Binding VisualStatus}" TextWrapping="Wrap" Margin="0,16,0,0"/>
        <StackPanel Margin="0,18,0,0">
            <Button x:Name="CountAction" Style="{StaticResource LiveAction}" Click="ToggleClick"
                    HorizontalAlignment="Left" AutomationProperties.Name="{Binding VisualCaptureAction}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                          Focusable="False" IsHitTestVisible="False">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="M 0,0 L 0,12 L 10,6 Z"/>
                                <Setter Property="Fill" Value="{StaticResource Ground}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VisualCaptureEnabled}" Value="True">
                                        <Setter Property="Data" Value="M 0,0 L 12,0 L 12,12 L 0,12 Z"/>
                                        <Setter Property="Fill" Value="{StaticResource Ink}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Text="{Binding VisualCaptureAction}"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Opcional · no se guardan ni se envían capturas." FontSize="12"
                       Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
        </StackPanel>
        <TextBlock Text="Es una estimación. Los cofres rotos sin aviso pueden sumarse al finalizar la partida."
                   FontSize="12" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
        <StackPanel x:Name="SquadSection" Margin="0,20,0,0"
                    Visibility="{Binding HasSquadRows, Converter={StaticResource LiveVisible}}">
            <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,16"/>
            <TextBlock Text="{Binding SquadContext}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding SquadRows}" AutomationProperties.Name="Jugadores y origen de sus cifras">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Chests}" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" AutomationProperties.Name="Cofres registrados"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <Expander x:Name="CountDetails" Header="Detalles del conteo" IsExpanded="False"
                  Foreground="{StaticResource Muted}" Margin="0,16,0,0"
                  Visibility="{Binding VisualCaptureEnabled, Converter={StaticResource LiveVisible}}">
            <TextBlock Text="{Binding VisualDiagnostic}" TextWrapping="Wrap" FontSize="12" Margin="20,8,0,0"/>
        </Expander>
    </StackPanel>
</UserControl>
