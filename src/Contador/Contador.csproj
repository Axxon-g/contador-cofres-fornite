    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Contador</AssemblyName><Version>1.2.7</Version>
    <ApplicationIcon>Assets/Contador.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed><EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Contador.Engine/Contador.Engine.csproj"/></ItemGroup>
  <ItemGroup><Resource Include="Assets/pirate-shop-token.png"/><Resource Include="Assets/Contador.ico"/></ItemGroup>
</Project>
