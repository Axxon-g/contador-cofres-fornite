<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Contador</AssemblyName>
    <Version>2.0.0</Version>
    <ApplicationIcon>Assets/Contador.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Contador.Engine/Contador.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/pirate-shop-token.png" />
    <Resource Include="Assets/Contador.ico" />
    <Resource Include="Assets/pirate-chest.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/island-43.10.base64" LogicalName="Contador.Map.Island4310" />
    <EmbeddedResource Include="../../vendor/LICENSE-Inceptofn-Live.txt" LogicalName="Contador.Licenses.LiveCapture" />
  </ItemGroup>
</Project>