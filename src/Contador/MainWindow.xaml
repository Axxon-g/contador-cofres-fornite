<Window x:Class="Contador.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Style="{StaticResource {x:Type Window}}" Icon="/Contador;component/Assets/Contador.ico" Title="Contador · Fortnite" Width="1120" Height="780" MinWidth="860" MinHeight="640" WindowStartupLocation="CenterScreen">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#6E2636" Padding="22,30">
<DockPanel LastChildFill="False">
<StackPanel DockPanel.Dock="Top">
<Image Source="/Contador;component/Assets/pirate-shop-token.png" Width="112" Height="112" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="Moneda de tesoro pirata"/>
<TextBlock Text="Contador" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Tu botín, en cifras." Foreground="#BDCEE3" Margin="0,6,0,32"/>
<Button x:Name="NavSummary" Content="_Resumen" Click="SummaryClick" HorizontalContentAlignment="Left" Margin="0,0,0,10"/>
<Button x:Name="NavHistory" Content="_Historial" Click="HistoryClick" Margin="0,0,0,10"/>
<Button x:Name="NavSettings" Content="_Ajustes" Click="SettingsClick" Margin="0,0,0,10"/>
</StackPanel>
<StackPanel DockPanel.Dock="Bottom">
<TextBlock Text="FORTNITE" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Repeticiones locales.&#10;Tus datos se quedan aquí." Foreground="#BDCEE3" FontSize="12" Margin="0,8,0,0"/>
</StackPanel>
</DockPanel>
</Border>
<Grid Grid.Column="1" Margin="32,28">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,20"><TextBlock x:Name="PageTitle" Text="Tu próxima partida cuenta." FontSize="28" FontWeight="SemiBold"/><TextBlock Text="v1.2" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
<Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="16,13" Margin="0,0,0,22">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{Binding MatchState}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Gold}" Margin="0,0,0,8"/><TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/><TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,12,0"/></StackPanel>
<Button Grid.Column="1" Content="{Binding ScanLabel}" Click="ScanClick" IsEnabled="{Binding CanScan}" Margin="8,0,0,0" VerticalAlignment="Center"/>
</Grid></Border>
<Grid Grid.Row="2">
<ScrollViewer x:Name="SummaryPanel" VerticalScrollBarVisibility="Auto">
<StackPanel>
<Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Cofres abiertos" FontSize="17" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Total}" FontSize="76" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,0,0,0"/><TextBlock Text="{Binding ProfileLabel}" Foreground="{StaticResource Muted}"/></StackPanel>
<StackPanel Grid.Column="1" Margin="20,8,0,0"><TextBlock Text="Cofres de esta sesión" FontSize="17"/><TextBlock Text="{Binding Session}" FontSize="42" FontWeight="SemiBold" Margin="0,3,0,8"/><TextBlock Text="{Binding SessionDetail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><TextBlock Text="{Binding LastMatch}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Stats}" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/></StackPanel>
</Grid>
<Border Height="1" Background="{StaticResource Line}"/>
<Grid Margin="0,22,0,16"><TextBlock Text="Últimas partidas" FontSize="20" FontWeight="SemiBold"/><Button Content="Ver historial" Click="HistoryClick" HorizontalAlignment="Right" Padding="14,7" Margin="0"/></Grid>
<TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
<DataGrid x:Name="RecentGrid" ItemsSource="{Binding Recent}" MaxHeight="250" AutomationProperties.Name="Últimas partidas"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" SortMemberPath="DateSort" Width="*"/><DataGridTextColumn Header="Modo" Binding="{Binding Mode}" Width="*"/><DataGridTextColumn Header="Cofres" Binding="{Binding Chests}" Width="85"/><DataGridTextColumn Header="Posición" Binding="{Binding Placement}" Width="85"/></DataGrid.Columns></DataGrid>
<Border Background="#20364C" Padding="18" CornerRadius="10" Margin="0,20,0,0"><TextBlock Text="Activa Grabar repeticiones en Fortnite → Ajustes → Juego → Repeticiones. Los cofres se suman al finalizar la partida, cuando la repetición está lista." Foreground="#E2D1AD"/></Border>
</StackPanel></ScrollViewer>
<Grid x:Name="HistoryPanel" Visibility="Collapsed">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><Label Content="Buscar por fecha o modo" Target="{Binding ElementName=SearchInput}" Foreground="{StaticResource Muted}" Padding="0,0,0,6"/><TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar por fecha o modo" ToolTip="Buscar por fecha o modo"/></StackPanel><Button Grid.Column="1" Content="Exportar CSV" Click="ExportClick" Margin="0"/></Grid>
<DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedMatch}" AutomationProperties.Name="Historial de partidas"><DataGrid.Columns><DataGridTextColumn Header="Fecha" Binding="{Binding Date}" SortMemberPath="DateSort" Width="*"/><DataGridTextColumn Header="Modo" Binding="{Binding Mode}" Width="*"/><DataGridTextColumn Header="Cofres" Binding="{Binding Chests}" Width="80"/><DataGridTextColumn Header="Tesoros" Binding="{Binding Treasures}" Width="80"/><DataGridTextColumn Header="Posición" Binding="{Binding Placement}" Width="80"/></DataGrid.Columns></DataGrid>
<TextBlock Grid.Row="2" Text="{Binding MatchDetail}" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
</Grid>
<ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Repeticiones" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Se leen sin modificar los archivos del juego." Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
<TextBox x:Name="DemosPath" AutomationProperties.Name="Carpeta de repeticiones" IsReadOnly="True"/>
<StackPanel Orientation="Horizontal" Margin="0,12,0,24"><Button Content="Elegir carpeta" Click="FolderClick" IsEnabled="{Binding CanEdit}"/><Button Content="Abrir carpeta" Click="OpenDemosClick"/></StackPanel>
<TextBlock Text="Cuenta" FontSize="20" FontWeight="SemiBold"/>
<ComboBox x:Name="ProfilePicker" Foreground="#101C2E" Background="#FFF4DF" DisplayMemberPath="Name" SelectedValuePath="Key" SelectionChanged="ProfileChanged" Margin="0,12,0,24" Padding="10" AutomationProperties.Name="Seleccionar cuenta" IsEnabled="{Binding CanEdit}"/>
<TextBlock Text="Overlay en el juego" FontSize="20" FontWeight="SemiBold"/>
<CheckBox x:Name="OverlayCheck" Content="Mostrar contador sobre el juego" Click="OverlayClick" IsEnabled="{Binding CanEdit}"/>
<StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Button Content="Mostrar / ocultar" Click="ToggleOverlayClick"/><Button Content="Bloquear / mover" Click="LockOverlayClick"/></StackPanel>
<TextBlock Text="Ctrl + Mayús + O: mostrar u ocultar. Ctrl + Mayús + L: bloquear o mover. Usa Pantalla completa en ventana en Fortnite." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
<TextBlock Text="Tamaño del overlay" Margin="0,4,0,4"/><Slider x:Name="OverlayScale" Minimum="70" Maximum="175" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" AutomationProperties.Name="Tamaño del overlay" IsEnabled="{Binding CanEdit}"/>
<Button Content="Aplicar tamaño" Click="ScaleClick" HorizontalAlignment="Left" Margin="0,8,0,24" IsEnabled="{Binding CanEdit}"/>
<TextBlock Text="Datos locales" FontSize="20" FontWeight="SemiBold"/>
<TextBlock Text="El historial se guarda automáticamente. Puedes usar overlay.html como fuente de navegador local en OBS." Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
<StackPanel Orientation="Horizontal"><Button Content="Abrir datos" Click="OpenDataClick"/><Button Content="Ver informe" Click="ReportClick"/><Button Content="Registro de errores" Click="ErrorsClick"/></StackPanel>
</StackPanel></ScrollViewer>
</Grid>
<Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Footer}" Foreground="{StaticResource Muted}" FontSize="12"/><Button Grid.Column="1" Content="{Binding PauseLabel}" Click="PauseClick" Padding="12,6" Margin="12,0,0,0"/></Grid>
</Grid>
</Grid></Window>
