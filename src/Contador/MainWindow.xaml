<Window x:Class="Contador.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Contador" Style="{StaticResource {x:Type Window}}" Icon="/Contador;component/Assets/Contador.ico" Title="Contador · Fortnite" Width="1180" Height="820" MinWidth="860" MinHeight="640" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="TeamVisible" />
    </Window.Resources>
    <Grid Background="{StaticResource Ground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource Rail}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,24">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Vertical" Margin="0,0,0,22" HorizontalAlignment="Center">
                        <Image Source="/Contador;component/Assets/pirate-shop-token.png" Width="72" Height="72" Stretch="Uniform" Margin="0,0,0,8" AutomationProperties.Name="Moneda de tesoro pirata" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Contador" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Tu botín, en cifras." Foreground="{StaticResource Coral}" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="NavSummary" Click="SummaryClick" Style="{StaticResource NavigationButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,7 L 8,1 L 15,7 M 3,6 L 3,15 L 6,15 L 6,10 L 10,10 L 10,15 L 13,15 L 13,6" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <AccessText Text="_Resumen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavStatistics" Click="StatisticsClick" Style="{StaticResource NavigationButton}">
                        <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Orientation="Horizontal">
                            <Path Data="M 2,15 L 2,9 M 7,15 L 7,4 M 12,15 L 12,1" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <AccessText Text="_Estadísticas" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavHistory" Click="HistoryClick" Style="{StaticResource NavigationButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 3,2 L 13,2 L 13,15 L 3,15 Z M 5,6 L 11,6 M 5,10 L 11,10" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <AccessText Text="_Historial" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavTeam" Click="TeamPageClick" Style="{StaticResource NavigationButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 5,3 A 2,2 0 1 1 4.9,3 M 1,15 L 1,12 Q 5,7 9,12 L 9,15 M 11,4 A 2,2 0 1 1 10.9,4 M 11,10 Q 15,10 15,14" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <AccessText Text="_Equipo" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavRoutes" Click="RoutesClick" Style="{StaticResource NavigationButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,3 L 6,1 L 11,3 L 15,1 L 15,13 L 11,15 L 6,13 L 1,15 Z M 6,1 L 6,13 M 11,3 L 11,15" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <AccessText Text="Mapa y r_utas" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavReport" Click="ReportPageClick" Style="{StaticResource NavigationButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 2,1 L 2,15 L 15,15 M 5,12 L 5,8 M 9,12 L 9,4 M 13,12 L 13,6" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <AccessText Text="_Informe" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavSettings" Click="SettingsClick" Style="{StaticResource NavigationButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,4 L 15,4 M 1,12 L 15,12 M 5,1 L 5,7 M 11,9 L 11,15" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <AccessText Text="A_justes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="Tus datos, en tu PC" FontSize="12" Foreground="{StaticResource Muted}" />
                    <TextBlock Text="{x:Static local:AppVersion.Label}" FontSize="12" Foreground="{StaticResource Gold}" Margin="0,6,0,0" />
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock x:Name="PageTitle" Foreground="{StaticResource Sea}" Text="Resumen" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitle" Text="Tu actividad, en un vistazo." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Cuenta" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" />
                    <ComboBox x:Name="ProfilePicker" AutomationProperties.Name="Seleccionar cuenta" ToolTip="{Binding ProfileLabel}" />
                </StackPanel>
            </Grid>
            <Border x:Name="StatusPanel" Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,20">
                <Grid Background="{StaticResource Ground}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding MatchState}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,0,16,4" />
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="12" Margin="0,0,0,4" ToolTip="{Binding StatusDetail}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding PeriodLabel}" Foreground="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding ScanLabel}" Click="ScanClick" IsEnabled="{Binding CanScan}" Margin="0" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Grid Grid.Row="2">
                <ScrollViewer x:Name="SummaryPanel" VerticalScrollBarVisibility="Auto" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                    <StackPanel>
                        <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="22" Margin="0,0,0,26">
                            <local:LiveMatchView ToggleRequested="VisualCaptureClick" xmlns:local="clr-namespace:Contador" />
                        </Border>
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tus cofres registrados" FontSize="17" Foreground="{StaticResource Muted}" />
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Contador;component/Assets/pirate-chest.png" Width="56" Height="56" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,12,0" IsHitTestVisible="False" AutomationProperties.Name="Cofre pirata" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Total}" FontSize="60" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding ProfileLabel}" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding OwnChestRewards}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="20,8,0,0">
                                <TextBlock Text="Cofres de esta sesión" FontSize="17" />
                                <TextBlock Text="{Binding Session}" FontSize="36" FontWeight="SemiBold" Margin="0,3,0,8" />
                                <TextBlock Text="{Binding SessionDetail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding LastMatch}" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="{Binding Stats}" Foreground="{StaticResource Muted}" Margin="0,9,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Line}" />
                        <Grid Margin="0,22,0,16">
                            <TextBlock Text="Últimas partidas" FontSize="20" FontWeight="SemiBold" />
                            <Button Content="Ver historial" Click="HistoryClick" HorizontalAlignment="Right" Padding="14,7" Margin="0" />
                        </Grid>
                        <TextBlock Text="{Binding EmptyMessage}" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
                        <DataGrid x:Name="RecentGrid" ItemsSource="{Binding Recent}" MaxHeight="250" AutomationProperties.Name="Últimas partidas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" SortMemberPath="DateSort" Width="*" />
                                <DataGridTextColumn Header="Modo" Binding="{Binding Mode}" Width="*" />
                                <DataGridTextColumn Header="Cofres" Binding="{Binding Chests}" Width="85" />
                                <DataGridTextColumn Header="Posición" Binding="{Binding Placement}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Background="{StaticResource Raised}" Padding="18" CornerRadius="10" Margin="0,20,0,0">
                            <TextBlock Text="Activa Grabar repeticiones en Fortnite → Ajustes → Juego → Repeticiones. Los cofres se suman al finalizar la partida, cuando la repetición está lista." Foreground="{StaticResource Muted}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <local:PlayerStatisticsView x:Name="StatisticsPanel" Visibility="Collapsed" />
                <Grid x:Name="HistoryPanel" Visibility="Collapsed" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <Label Content="Buscar por fecha o modo" Target="{Binding ElementName=SearchInput}" Foreground="{StaticResource Muted}" Padding="0,0,0,6" />
                            <TextBox x:Name="SearchInput" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Buscar por fecha o modo" ToolTip="Buscar por fecha o modo" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Exportar CSV" Click="ExportClick" Margin="0" />
                    </Grid>
                    <DataGrid x:Name="HistoryGrid" Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedMatch}" AutomationProperties.Name="Historial de partidas">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" SortMemberPath="DateSort" Width="*" />
                            <DataGridTextColumn Header="Modo" Binding="{Binding Mode}" Width="*" />
                            <DataGridTextColumn Header="Cofres" Binding="{Binding Chests}" Width="80" />
                            <DataGridTextColumn Header="Tesoros" Binding="{Binding Treasures}" Width="80" />
                            <DataGridTextColumn Header="Posición" Binding="{Binding Placement}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding MatchDetail}" Foreground="{StaticResource Muted}" Margin="0,16,0,0" />
                </Grid>
                <ScrollViewer x:Name="TeamPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Añade repeticiones de tus compañeros para ampliar la cobertura sin duplicar cofres." Foreground="{StaticResource Muted}" Margin="0,0,0,10" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Importar repeticiones del equipo" Style="{StaticResource PrimaryButton}" Click="ImportTeamReplaysClick" IsEnabled="{Binding CanEdit}" Margin="0,0,10,8" />
                            <Button Content="Abrir carpeta de repeticiones" Click="OpenDemosClick" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="Partida" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding TeamMatches}" SelectedItem="{Binding SelectedTeamMatch}" DisplayMemberPath="Label" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Partida del equipo" Margin="0,0,0,18" />
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding TeamSelectedTotal}" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,0,14,0" />
                            <TextBlock Text="cofres del equipo · mínimo registrado" Foreground="{StaticResource Muted}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding TeamSelectedCoverage}" Foreground="{StaticResource Muted}" Margin="0,0,0,18" />
                        <DataGrid ItemsSource="{Binding TeamPlayers}" MaxHeight="310" AutomationProperties.Name="Conteo por jugador y procedencia">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Jugador" Binding="{Binding Name}" Width="150" />
                                <DataGridTextColumn Header="Cofres" Binding="{Binding Count}" Width="85" />
                                <DataGridTextColumn Header="Origen" Binding="{Binding Source}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Cobertura" Binding="{Binding Coverage}" Width="240" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="≥ indica un mínimo, no un total exacto. Incluso varias repeticiones pueden omitir acciones; las estimaciones visuales no se incluyen aquí." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,24" />
                        <Expander Header="Repeticiones importadas de esta partida" Foreground="{StaticResource Ink}" Margin="0,0,0,18">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Puedes retirar una fuente sin borrar su archivo ni tu historial personal." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />
                                <DataGrid ItemsSource="{Binding TeamSourceFiles}" MaxHeight="230" AutomationProperties.Name="Fuentes importadas del equipo">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Grabada por" Binding="{Binding Player}" Width="150" />
                                        <DataGridTextColumn Header="Archivo" Binding="{Binding File}" Width="*" MinWidth="220" />
                                        <DataGridTemplateColumn Header="Acción" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Retirar" Click="RemoveTeamSourceClick" Tag="{Binding}" Padding="10,5" Margin="0" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="Retirar todas las fuentes importadas" Click="ClearTeamReplaysClick" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Resultado de la última importación" Foreground="{StaticResource Ink}" Margin="0,0,0,20">
                            <TextBlock Text="{Binding TeamImportSummary}" Foreground="{StaticResource Muted}" Margin="0,10,0,0" />
                        </Expander>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,16" />
                        <CheckBox Content="Mostrar también el resumen acumulado del equipo" IsChecked="{Binding ShowTeamStats}" Click="TeamStatsClick" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Mostrar resumen acumulado del equipo" />
                        <StackPanel x:Name="TeamSummaryPanel" Visibility="{Binding ShowTeamStats, Converter={StaticResource TeamVisible}}" Margin="0,0,0,24" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                            <TextBlock Text="Equipo · registro parcial" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="El conteo grupal puede no ser 100 % preciso. Las repeticiones pueden omitir aperturas de compañeros y el origen de algunas recompensas es estimado. Tus cifras personales no cambian." Foreground="{StaticResource Gold}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,4" />
                            <WrapPanel Margin="0,12,0,8">
                                <TextBlock Text="{Binding TeamChestTotal}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,0,10,0" />
                                <TextBlock Text="mínimo registrado · tus cofres + compañeros detectados" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            </WrapPanel>
                            <TextBlock Text="{Binding TeamChestSplit}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding TeamCoverage}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TeamMembers}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding TeamEvidence}" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Recompensas atribuidas a compañeros" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TeammateRewards}" Margin="0,6,0,14" />
                            <TextBlock Text="{Binding OwnChestRewards}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding OtherOwnRewards}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Las atribuciones estimadas no son recompensas verificadas. No se suman al registro propio. En el overlay, ≥ indica el mínimo registrado del equipo en la última partida." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <local:RouteSuggestionsView x:Name="RoutesPanel" Visibility="Collapsed" />
                <local:PlayerReportView x:Name="ReportPanel" Visibility="Collapsed" />
                <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                    <StackPanel>
                        <TextBlock Text="Fechas del contador" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Se aplica al resumen, historial, informe y overlays. Las partidas antiguas se conservan." Foreground="{StaticResource Muted}" Margin="0,6,0,12" />
                        <WrapPanel>
                            <StackPanel Margin="0,0,16,12">
                                <Label Content="Desde (incluido)" Target="{Binding ElementName=PeriodFrom}" Foreground="{StaticResource Ink}" Padding="0,0,0,6" />
                                <DatePicker x:Name="PeriodFrom" Width="160" Language="es-MX" Foreground="{StaticResource Ink}" Background="{StaticResource Panel}" SelectedDateFormat="Short" DateValidationError="PeriodDateError" AutomationProperties.Name="Fecha inicial del contador" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <Label Content="Hasta (incluido)" Target="{Binding ElementName=PeriodThrough}" Foreground="{StaticResource Ink}" Padding="0,0,0,6" />
                                <DatePicker x:Name="PeriodThrough" Width="160" Language="es-MX" Foreground="{StaticResource Ink}" Background="{StaticResource Panel}" SelectedDateFormat="Short" DateValidationError="PeriodDateError" AutomationProperties.Name="Fecha final del contador" />
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Deja una fecha vacía para no limitar ese extremo. Se usa la hora local de Windows." Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock x:Name="PeriodError" Foreground="#FFB09A" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                        <WrapPanel Margin="0,10,0,24">
                            <Button Content="Aplicar fechas" Click="ApplyPeriodClick" Margin="0,0,10,10" />
                            <Button Content="Desde 01/11/2026" Click="EventPeriodClick" Margin="0,0,10,10" ToolTip="Fecha inicial: 1 de noviembre de 2026. Sin fecha final." />
                            <Button Content="Todo el historial" Click="ClearPeriodClick" Margin="0,0,0,10" />
                        </WrapPanel>
                        <TextBlock Text="Repeticiones" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Se leen sin modificar los archivos del juego." Foreground="{StaticResource Muted}" Margin="0,6,0,14" />
                        <TextBox x:Name="DemosPath" AutomationProperties.Name="Carpeta de repeticiones" IsReadOnly="True" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,24">
                            <Button Content="Elegir carpeta" Click="FolderClick" IsEnabled="{Binding CanEdit}" />
                            <Button Content="Abrir carpeta" Click="OpenDemosClick" />
                        </StackPanel>
                        <TextBlock Text="Overlay en el juego" FontSize="20" FontWeight="SemiBold" />
                        <CheckBox x:Name="OverlayCheck" Content="Mostrar contador sobre el juego" Click="OverlayClick" IsEnabled="{Binding CanEdit}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="Mostrar / ocultar" Click="ToggleOverlayClick" />
                            <Button Content="Bloquear / mover" Click="LockOverlayClick" />
                        </StackPanel>
                        <TextBlock Text="Ctrl + Mayús + O: mostrar u ocultar. Ctrl + Mayús + L: bloquear o mover. Usa Pantalla completa en ventana en Fortnite." Foreground="{StaticResource Muted}" Margin="0,0,0,14" />
                        <TextBlock Text="Tamaño del overlay" Margin="0,4,0,4" />
                        <Slider x:Name="OverlayScale" Minimum="70" Maximum="175" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" AutomationProperties.Name="Tamaño del overlay" IsEnabled="{Binding CanEdit}" />
                        <Button Content="Aplicar tamaño" Click="ScaleClick" HorizontalAlignment="Left" Margin="0,8,0,24" IsEnabled="{Binding CanEdit}" />
                        <TextBlock Text="Datos locales" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="El historial se guarda automáticamente. Puedes usar overlay.html como fuente de navegador local en OBS." Foreground="{StaticResource Muted}" Margin="0,8,0,12" />
                        <WrapPanel>
                            <Button Content="Abrir datos" Click="OpenDataClick" />
                            <Button Content="Ver informe" Click="ReportPageClick" />
                            <Button Content="Registro de errores" Click="ErrorsClick" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Footer}" ToolTip="{Binding Footer}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="11" />
                <Button Grid.Column="1" Content="{Binding PauseLabel}" Click="PauseClick" Padding="12,7" Margin="12,0,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Window>