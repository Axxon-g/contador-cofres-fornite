<UserControl x:Class="Contador.TreasureOddsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Ground}" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,16,24">
            <Grid x:Name="TopBlocks" SizeChanged="TopBlocksSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
            <Border x:Name="HistoryBlock" Background="{StaticResource Panel}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock x:Name="HistoryContext" Foreground="{StaticResource Muted}" FontSize="12" />
                        <TextBlock Text="Cofres propios registrados" FontSize="13" Margin="0,10,0,0" />
                        <TextBlock x:Name="HistoryCount" FontSize="32" FontWeight="SemiBold"
                                   Foreground="{StaticResource Gold}" Margin="0,2,0,6" />
                        <TextBlock Text="Tus cofres son el punto de partida del cálculo, no una garantía de premio."
                                   Foreground="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <Image Grid.Column="1" Source="/Contador;component/Assets/pirate-shop-token.png"
                           Width="48" Height="48" Stretch="Uniform" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Border x:Name="SimulationBlock" Background="{StaticResource Panel}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Simulador" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Explora otro escenario sin cambiar tus cofres registrados."
                               Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12" />
                    <CheckBox x:Name="Simulate" Content="Probar otra cantidad de cofres"
                              Checked="InputsChanged" Unchecked="InputsChanged" />
                    <StackPanel x:Name="SimulationInputs" Visibility="Collapsed" Margin="0,12,0,0">
                        <Label Content="Cofres de la simulación" Target="{Binding ElementName=ChestInput}" />
                        <TextBox x:Name="ChestInput" Text="0" TextChanged="InputsChanged" MaxLength="12"
                                 HorizontalAlignment="Left" MinWidth="180" AutomationProperties.Name="Cofres de la simulación" />
                        <CheckBox x:Name="Boosted" Content="Simular todos durante Horas del tesoro"
                                  Checked="InputsChanged" Unchecked="InputsChanged" Margin="0,12,0,0" />
                        <TextBlock Text="Es hipotético: no detectamos qué cofres abriste durante esas horas."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>

            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Probabilidades por recompensa" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="CalculationContext" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="0,6,0,16" />
                    <TextBlock x:Name="Validation" Foreground="{StaticResource Gold}"
                               AutomationProperties.LiveSetting="Polite" Margin="0,0,0,12" Visibility="Collapsed" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="115" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Recompensa" Foreground="{StaticResource Muted}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="1 de cada…" Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Right" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="2" Text="Al menos una" Foreground="{StaticResource Muted}" FontSize="11" TextAlignment="Right" />
                    </Grid>
                    <ItemsControl x:Name="OddsRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="115" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="14" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding OneInLabel}" Foreground="{StaticResource Muted}"
                                                   FontSize="12" TextAlignment="Right" Margin="0,0,16,0" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding ChanceLabel}" FontSize="20" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Gold}" TextAlignment="Right" />
                                            <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100" Height="3" Margin="20,5,0,0"
                                                         Foreground="{StaticResource Gold}" Background="{StaticResource Ground}"
                                                         BorderThickness="0" AutomationProperties.Name="{Binding AccessibleLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Probabilidad teórica de obtener al menos una recompensa. No indica lo que ya encontraste ni predice el próximo cofre."
                               Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" />
                    <TextBlock Text="Tasas comunitarias pendientes de verificación con Epic."
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </Border>



            <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="20">
                <StackPanel>
                    <Expander Header="Cómo interpretar las probabilidades" Foreground="{StaticResource Ink}">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Las tasas pueden cambiar con el evento. El cálculo supone intentos independientes y una tasa constante; no es un contador hacia un premio."
                                       Foreground="{StaticResource Muted}" FontSize="12" />
                            <TextBlock Text="Fórmula: 1 − (1 − probabilidad por cofre) elevado al número de cofres. Para premios semanales, usa solo las fechas en las que el premio estaba disponible."
                                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="Estimar partidas sin repetición" Foreground="{StaticResource Ink}" Margin="0,16,0,0">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Introduce las partidas totales de esta misma cuenta, período y modos. Usaremos tu media registrada. Esta aproximación no recupera aperturas ni se suma al historial."
                                       Foreground="{StaticResource Muted}" FontSize="12" />
                            <Label Content="Partidas totales del mismo período" Target="{Binding ElementName=PlayedInput}" Margin="0,8,0,0" />
                            <TextBox x:Name="PlayedInput" TextChanged="EstimateChanged" MaxLength="8" Width="180" HorizontalAlignment="Left"
                                     AutomationProperties.Name="Partidas totales del mismo período" />
                            <TextBlock x:Name="EstimateResult" Margin="0,12,0,0" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
