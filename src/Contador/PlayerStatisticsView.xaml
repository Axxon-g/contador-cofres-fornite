<UserControl x:Class="Contador.PlayerStatisticsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Busca un jugador. Sin claves ni contraseñas." Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
            <TextBlock Text="Escribe un nombre Epic, PlayStation o Xbox. La consulta pasa por el servicio de AXXON; la clave de Fortnite-API permanece en el servidor. No incluye cofres ni recompensas." Foreground="{StaticResource Muted}" Margin="0,6,0,18" TextWrapping="Wrap" />
            <CheckBox Content="Usar cuenta seleccionada en el contador" IsChecked="{Binding UseDetectedAccount}" Margin="0,0,0,6" />
            <TextBlock Text="{Binding DetectedProfile}" Foreground="{StaticResource Sea}" Margin="0,0,0,14" TextWrapping="Wrap" />
            <WrapPanel>
                <StackPanel Width="240" Margin="0,0,12,12" IsEnabled="{Binding ManualEnabled}" Visibility="{Binding ManualEnabled, Converter={StaticResource VisibleWhenTrue}}">
                    <Label Content="Nombre del jugador" Target="{Binding ElementName=PlayerNameInput}" Foreground="{StaticResource Ink}" Padding="0,0,0,6" />
                    <TextBox x:Name="PlayerNameInput" Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" AutomationProperties.Name="Nombre de jugador para buscar" />
                </StackPanel>
                <StackPanel Width="150" Margin="0,0,12,12" IsEnabled="{Binding ManualEnabled}" Visibility="{Binding ManualEnabled, Converter={StaticResource VisibleWhenTrue}}">
                    <Label Content="Cuenta" Target="{Binding ElementName=AccountTypeInput}" Foreground="{StaticResource Ink}" Padding="0,0,0,6" />
                    <ComboBox x:Name="AccountTypeInput" ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding SelectedAccountType}" DisplayMemberPath="Label" />
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,12,12">
                    <Label Content="Período de la API" Target="{Binding ElementName=WindowInput}" Foreground="{StaticResource Ink}" Padding="0,0,0,6" />
                    <ComboBox x:Name="WindowInput" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow}" DisplayMemberPath="Label" />
                </StackPanel>
                <StackPanel Width="190" Margin="0,0,0,12">
                    <Label Content="Tipo de control" Target="{Binding ElementName=ControlInput}" Foreground="{StaticResource Ink}" Padding="0,0,0,6" />
                    <ComboBox x:Name="ControlInput" ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" DisplayMemberPath="Label" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,12">
                <Button Content="Consultar estadísticas" Style="{StaticResource PrimaryButton}" Click="SearchClick" IsEnabled="{Binding CanSearch}" Margin="0,0,10,8" />
                <Button Content="Cancelar consulta" Click="CancelClick" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource Muted}" Margin="0,0,0,18" TextWrapping="Wrap" />
            <StackPanel Visibility="{Binding HasResult, Converter={StaticResource VisibleWhenTrue}}">
                <TextBlock Text="{Binding AccountName}" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource Gold}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ResultContext}" Foreground="{StaticResource Muted}" Margin="0,4,0,4" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Updated}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,18" TextWrapping="Wrap" />
                <WrapPanel Margin="0,0,0,12">
                    <StackPanel Width="140" Margin="0,0,14,16">
                        <TextBlock Text="{Binding Wins}" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Gold}" TextWrapping="Wrap" />
                        <TextBlock Text="Victorias" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,14,16">
                        <TextBlock Text="{Binding Matches}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Partidas" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,14,16">
                        <TextBlock Text="{Binding Kills}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Eliminaciones" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,14,16">
                        <TextBlock Text="{Binding Kd}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="K/D" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,14,16">
                        <TextBlock Text="{Binding WinRate}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Porcentaje de victorias" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,0,16">
                        <TextBlock Text="{Binding BattlePassLevel}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Nivel del pase actual" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                    </StackPanel>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding Modes}" MaxHeight="260" AutomationProperties.Name="Estadísticas por modalidad" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Modalidad" Binding="{Binding Mode}" Width="110" />
                        <DataGridTextColumn Header="Partidas" Binding="{Binding Matches}" Width="80" />
                        <DataGridTextColumn Header="Victorias" Binding="{Binding Wins}" Width="80" />
                        <DataGridTextColumn Header="Eliminaciones" Binding="{Binding Kills}" Width="110" />
                        <DataGridTextColumn Header="K/D" Binding="{Binding Kd}" Width="65" />
                        <DataGridTextColumn Header="Victorias %" Binding="{Binding WinRate}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="— indica dato no disponible. Tríos no está disponible en este endpoint. Los filtros de fechas del contador no afectan a estas estadísticas." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,20" TextWrapping="Wrap" />
            </StackPanel>
            <Border Height="1" Background="{StaticResource Line}" Margin="0,4,0,16" />
        </StackPanel>
    </ScrollViewer>
</UserControl>